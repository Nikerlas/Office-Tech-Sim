  m_Script: {fileID: 11500000, guid: 0dafe6fd2a080d2479c550f872806afe, type: 3}
  m_Name: Raden Sambung_start
  m_EditorClassIdentifier: 
  lines:
  - portrait: {fileID: 21300000, guid: 31cd273c714172c4a89fc5bdc8242159, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Raden Sambung
    dialogueText: 'Good day, shopkeeper.

      Is this where one acquires a PC?'
    portraitAnimation: 1
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 1
    speakerName: '{PLAYER}'
    dialogueText: Yep. You looking to build one?
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 231fadb4006ee09429fd975412378628, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Raden Sambung
    dialogueText: 'Indeed.

      My curiosity toward these modern machines grows
      stronger each day.'
    portraitAnimation: 0
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 4
    speakerName: '{PLAYER}'
    dialogueText: What you gonna use it for?
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 36c0a0d9341166e488d5f7862c5ce6a5, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Raden Sambung
    dialogueText: "Music, knowledge, art\u2026 perhaps a few modern games as well."
    portraitAnimation: 0
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 4
    speakerName: '{PLAYER}'
    dialogueText: Nice. Got a budget?
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 36c0a0d9341166e488d5f7862c5ce6a5, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 1
    speakerName: Raden Sambung
    dialogueText: 'Dont talk about any budget. I already have the square boxes

      Quality
      and elegance matter far more.'
    portraitAnimation: 0
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 1
    speakerName: '{PLAYER}'
    dialogueText: "Got it. I\u2019ll build something clean and powerful."
    portraitAnimation: 0
  nextForcedCustomer: {fileID: 0}
