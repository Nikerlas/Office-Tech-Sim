  lines:
  - portrait: {fileID: 21300000, guid: 31cd273c714172c4a89fc5bdc8242159, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Raden Sambung
    dialogueText: Greetings my good friend.
    portraitAnimation: 1
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 1
    speakerName: '{PLAYER}'
    dialogueText: Looking for  upgrade?
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 231fadb4006ee09429fd975412378628, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Raden Sambung
    dialogueText: My thirst for knowledge has yet to be satisfied.
    portraitAnimation: 0
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 4
    speakerName: '{PLAYER}'
    dialogueText: Anything in particular?
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 36c0a0d9341166e488d5f7862c5ce6a5, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Raden Sambung
    dialogueText: Rendering worthy of this marvelous machine.
    portraitAnimation: 0
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 4
    speakerName: '{PLAYER}'
    dialogueText: Nice. Got a budget?
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 36c0a0d9341166e488d5f7862c5ce6a5, type: 3}
    portraitSide: 0
    usePlayerPortrait: 0
    playerExpression: 1
    speakerName: Raden Sambung
    dialogueText: Whichever grants the finest experience.
    portraitAnimation: 0
  - portrait: {fileID: 0}
    portraitSide: 2
    usePlayerPortrait: 1
    playerExpression: 1
    speakerName: '{PLAYER}'
    dialogueText: I think I know just the one.
    portraitAnimation: 0
