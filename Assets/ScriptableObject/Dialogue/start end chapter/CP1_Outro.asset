  lines:
  - portrait: {fileID: 21300000, guid: 0965960662a31e0498b0f878c769bff6, type: 3}
    portraitSide: 1
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: Jeki
    dialogueText: Days turned into weeks. The store was still small, but people were
      starting to recognize our name.
    portraitAnimation: 0
  - portrait: {fileID: 21300000, guid: 7ec44125f5152244cb3aed97c61bbdd6, type: 3}
    portraitSide: 1
    usePlayerPortrait: 0
    playerExpression: 0
    speakerName: 
    dialogueText: More customers began walking through our doors. For the first time...
      It felt like this business might actually succeed.
    portraitAnimation: 0
